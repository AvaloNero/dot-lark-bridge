# No real credentials or identity values are included. The blank template denies access.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/bridge.sqlite
STORAGE_KEY=

AUTH_MODE=deny
MCP_OWNER_SUBJECT=
DEV_BEARER_TOKEN=
PUBLIC_ORIGIN=
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPE=lark:bridge
MCP_CALLBACK_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Production: OAuth + one explicitly verified self-built Feishu app/tenant/user/private chat.
# Live transport accepts only long-connection; there is no public inbound webhook.
LARK_TRANSPORT=disabled
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
LARK_OWNER_OPEN_ID=
LARK_OWNER_CHAT_ID=

# This is bridge policy, not a claimed Feishu platform passive-reply window.
REPLY_TTL_SECONDS=900
SUBSCRIPTION_TTL_SECONDS=86400
QUEUE_LIMIT=100
INBOUND_PER_MINUTE=10
REPLIES_PER_MINUTE=10
MAX_DELIVERY_ATTEMPTS=5
